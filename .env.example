# Debug mode
VITE_DEBUG=false

# API Configuration
VITE_API_BASE_URL=https://bot.tpekollec.ru/api
VITE_API_TIMEOUT=10000

# WebSocket Configuration
VITE_WS_KEY=your_websocket_key_here
VITE_WS_HOST=bot.tpekollec.ru
VITE_WS_PORT=80
VITE_WSS_PORT=443
VITE_WS_AUTH_ENDPOINT=https://bot.tpekollec.ru/broadcasting/auth

# Analytics & Monitoring
VITE_LOGROCKET_APP_ID=your_logrocket_app_id_here
VITE_YANDEX_METRIKA_ID=your_yandex_metrika_id_here
VITE_ENABLE_ANALYTICS=true
